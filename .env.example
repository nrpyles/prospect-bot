# CRM access requires the Clerk-verified email nrpyles@gmail.com.
# The owner email is pinned in src/lib/private-access.ts as explicitly requested.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=
# Keep this stable. Preserve the current effective key if migrating existing tokens.
TOKEN_ENCRYPTION_KEY=
# Optional search services. Existing organization Google key is also supported.
FUNNELCLOSER_GMAPS_API_KEY=
FIRECRAWL_API_KEY=
# Optional paid AI drafting. Free templates work without this key.
ANTHROPIC_API_KEY=
# Personal Gmail OAuth client, configured separately in your Google project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Disposable test database only. Never point this at production.
TEST_DATABASE_URL=
